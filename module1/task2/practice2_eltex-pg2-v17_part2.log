            extra[a[i]]=extra[a[i]] (extra[a[i]]!="" ? "," : "") $1
    next
}

$7=="/usr/sbin/nologin" {
    gr=g[$4]

    if(extra[$1]!="")
        gr=gr (gr!="" ? "," : "") extra[$1]

    print $3 ", " $1 ", " gr
}
